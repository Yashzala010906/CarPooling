# Supabase connection for the Enterprise Carpooling Platform.
# These are the public client keys (safe to expose in the browser).
# Copy this file to `.env` and fill in your own project's values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key
