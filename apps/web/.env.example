# ─────────────────────────── Supabase ───────────────────────────
# Member 3 (Trip Execution & Financial System) is built on Supabase.
# Project ref: fyktryxrfemcvcgepnqp  ->  Settings ▸ API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://fyktryxrfemcvcgepnqp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — NEVER prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────── Payments ───────────────────────────
# Razorpay Test Mode. Only the public key id is exposed to the browser;
# the key secret stays server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# ─────────────────────────── Maps ───────────────────────────────
# Google Maps (placeholder — leave empty to use the map placeholder component)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─────────────── Legacy NestJS API (other members) ──────────────
# Member 3 talks to Supabase directly; these remain for modules that still
# use the NestJS backend.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
