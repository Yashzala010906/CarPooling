# ---------------------------------------------------------------------------
# Supabase (Member 1 — User, Company & Vehicle System)
# Get these from: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used for privileged operations that must bypass RLS
# (e.g. cleaning up a half-created auth user if profile creation fails).
# NEVER expose this to the browser / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app — used to build Supabase auth redirect links
# (password reset / email confirmation). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Legacy NestJS API (other team members' modules) — optional, unused by Member 1
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
